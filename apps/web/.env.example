# Optional: set this only when the browser should call a separately hosted API.
# By default, requests use the same-origin /api rewrite configured in next.config.ts.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional server-side target for the Next.js /api rewrite (defaults to local FastAPI).
# INTERNAL_API_URL=http://127.0.0.1:8000
