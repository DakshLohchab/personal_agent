# Example only. Copy this file to .env and replace the placeholders locally.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false