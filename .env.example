# Example only. Copy this file to .env and replace the placeholders locally.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_PRESIGN_TTL_SECONDS=300
R2_MAX_UPLOAD_BYTES=52428800